<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Properties -->
    <PackageId>MasLazu.AspNet.Authorization.Rbac</PackageId>
    <Authors>MasLazu</Authors>
    <Company>MasLazu</Company>
    <Description>Application layer for MasLazu ASP.NET Authorization RBAC. Contains services, extensions, validators, and utilities for role-based access control.</Description>
    <PackageTags>aspnetcore;authorization;rbac;services;application;roles;permissions</PackageTags>
    <RepositoryUrl>https://github.com/maslazu/MasLazu.AspNet.Authorization.Rbac</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/maslazu/MasLazu.AspNet.Authorization.Rbac</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See RELEASES.md for release notes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MasLazu.AspNet.Authorization.Rbac.Abstraction\MasLazu.AspNet.Authorization.Rbac.Abstraction.csproj" />
    <ProjectReference Include="..\MasLazu.AspNet.Authorization.Rbac.Domain\MasLazu.AspNet.Authorization.Rbac.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
